#!/bin/bash
# unifideck-launcher - UMU-based game launcher for Unifideck
#
# Usage: unifideck-launcher "store:game_id"
#
# This script reads from ~/.local/share/unifideck/games.map
# Format of map file: store:game_id|/path/to/exe|/path/to/workdir
#
# For Windows .exe games, umu-launcher handles Proton execution with:
# - Automatic prefix creation
# - Protonfixes from umu-database
# - Steam Runtime container

set -e

LOG_FILE="$HOME/.local/share/unifideck/launcher.log"
MAP_FILE="$HOME/.local/share/unifideck/games.map"
PREFIXES_DIR="$HOME/.local/share/unifideck/prefixes"

# Handle termination signals (SIGTERM from Steam's TerminateApp, SIGINT from Ctrl+C).
# Legendary orphans umu-run (spawns via Popen without wait), so killing the launcher
# alone leaves the game running. We must explicitly kill the container processes.
on_terminate() {
    echo "[$(date '+%H:%M:%S')] [Signal] Received termination signal, stopping game..." >> "$LOG_FILE"
    pkill -TERM -f "steam-runtime-launch-client" 2>/dev/null || true
    pkill -TERM -f "umu-run" 2>/dev/null || true
    sleep 1
    # Force kill if still alive
    pkill -KILL -f "steam-runtime-launch-client" 2>/dev/null || true
    pkill -KILL -f "umu-run" 2>/dev/null || true
    echo "[$(date '+%H:%M:%S')] [Signal] Cleanup complete" >> "$LOG_FILE"
    exit 143
}
trap on_terminate SIGTERM SIGINT

# Get the plugin directory (parent of bin/)
# Use pwd -P to resolve physical path (avoids Wine dosdevices/z: symlink issues)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PLUGIN_DIR="$(dirname "$SCRIPT_DIR")"
# Canonicalize to avoid Wine dosdevices/z: symlink resolution
if command -v realpath &>/dev/null; then
    PLUGIN_DIR="$(realpath "$PLUGIN_DIR")"
fi

# umu-run location (bundled zipapp)
UMU_RUN="$PLUGIN_DIR/bin/umu/umu/umu-run"

# Heroic-specific paths (preferred when available - proven working)
HEROIC_UMU_RUN="$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/tools/runtimes/umu/umu_run.py"
HEROIC_LEGENDARY_CONFIG="$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/legendaryConfig/legendary"

mkdir -p "$(dirname "$LOG_FILE")" "$PREFIXES_DIR"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# Toast notification for setup stages (visible in Game Mode)
# Usage: notify_stage "Stage Name" "Details..."
# 
# Writes to JSON file that the Decky plugin frontend polls.
# This ensures toasts appear in Steam Gaming Mode (notify-send doesn't work there).
TOAST_FILE="$HOME/.local/share/unifideck/launcher_toasts.json"

notify_stage() {
    local stage="$1"
    local message="$2"
    local urgency="${3:-normal}"  # low, normal, critical
    
    log "[STAGE] $stage: $message"
    
    # Write toast to JSON file for Decky frontend to display
    # The frontend polls this file and shows toasts via Steam's toast API
    local timestamp
    timestamp=$(date +%s.%N)
    
    # Create directory if needed
    mkdir -p "$(dirname "$TOAST_FILE")"
    
    # Read existing toasts (or start empty array)
    local existing="[]"
    if [ -f "$TOAST_FILE" ]; then
        existing=$(cat "$TOAST_FILE" 2>/dev/null || echo "[]")
        # Validate JSON is an array
        if ! echo "$existing" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
            existing="[]"
        fi
    fi
    
    # Append new toast using Python for proper JSON handling
    python3 -c "
import json
import sys

existing = json.loads('''$existing''')
toast = {
    'title': '''$stage''',
    'body': '''$message''',
    'urgency': '''$urgency''',
    'timestamp': $timestamp
}
existing.append(toast)
print(json.dumps(existing))
" > "$TOAST_FILE" 2>/dev/null || true
}

# Cloud save sync script (Python - uses legendary/gogdl)
CLOUD_SAVE_SCRIPT="$PLUGIN_DIR/bin/cloud_save_sync.py"

# Sync cloud saves before/after game launch
# Usage: sync_cloud_saves "epic|gog" "game_id" "download|upload" "prefix_path" ["save_path"]
sync_cloud_saves() {
    local store="$1"
    local game_id="$2"
    local direction="$3"
    local prefix_path="${4:-}"
    local save_path="${5:-}"
    
    if [ ! -f "$CLOUD_SAVE_SCRIPT" ]; then
        log "[CloudSave] Sync script not found, skipping"
        return 0
    fi
    
    log "[CloudSave] Syncing $store/$game_id ($direction)..."
    
    if python3 "$CLOUD_SAVE_SCRIPT" "$store" "$game_id" "$direction" "$prefix_path" "$save_path" 2>>"$LOG_FILE"; then
        log "[CloudSave] Sync completed successfully"
    else
        log "[CloudSave] Sync failed (non-critical, continuing)"
    fi
    return 0
}

# Reset environment to avoid conflicts
# Save Steam's LD_PRELOAD (contains overlay + Steam Input hooks) before clearing.
# We filter out 32-bit libraries that cause ABI errors with 64-bit games,
# then restore the filtered value before exec-ing the actual game process.
STEAM_LD_PRELOAD="${LD_PRELOAD:-}"
if [ -n "$STEAM_LD_PRELOAD" ]; then
    FILTERED_PRELOAD=""
    IFS=':' read -ra _PRELOAD_ENTRIES <<< "$STEAM_LD_PRELOAD"
    for _entry in "${_PRELOAD_ENTRIES[@]}"; do
        case "$_entry" in
            */ubuntu12_32/*|*/i386-linux-gnu/*)
                # Skip 32-bit libraries that cause ABI conflicts with 64-bit games
                ;;
            *)
                FILTERED_PRELOAD="${FILTERED_PRELOAD:+$FILTERED_PRELOAD:}$_entry"
                ;;
        esac
    done
    STEAM_LD_PRELOAD="$FILTERED_PRELOAD"
fi
log "Saved Steam LD_PRELOAD (filtered): ${STEAM_LD_PRELOAD:-(empty)}"

unset LD_PRELOAD
unset LD_LIBRARY_PATH
unset STEAM_RUNTIME
unset STEAM_COMPAT_CLIENT_INSTALL_PATH

# ==============================================================================
# Find Python 3.10+ - CRITICAL: umu-launcher requires Python 3.10+ (match statements)
# This MUST happen early before any umu-run usage
# ==============================================================================
find_python310_plus() {
    # Search in order of preference - newer versions first
    for py in \
        /usr/bin/python3.13 \
        /usr/bin/python3.12 \
        /usr/bin/python3.11 \
        /usr/bin/python3.10 \
        "$HOME/.local/bin/python3.13" \
        "$HOME/.local/bin/python3.12" \
        "$HOME/.local/bin/python3.11" \
        "$HOME/.local/bin/python3.10"
    do
        if [ -x "$py" ]; then
            # Verify it's actually 3.10+ by checking version
            version=$("$py" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null)
            if [ -n "$version" ]; then
                major=$(echo "$version" | cut -d. -f1)
                minor=$(echo "$version" | cut -d. -f2)
                if [ "$major" -ge 3 ] 2>/dev/null && [ "$minor" -ge 10 ] 2>/dev/null; then
                    echo "$py"
                    return 0
                fi
            fi
        fi
    done
    
    # Last resort: check if system python3 is 3.10+
    if command -v python3 &>/dev/null; then
        version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')" 2>/dev/null)
        if [ -n "$version" ]; then
            major=$(echo "$version" | cut -d. -f1)
            minor=$(echo "$version" | cut -d. -f2)
            if [ "$major" -ge 3 ] 2>/dev/null && [ "$minor" -ge 10 ] 2>/dev/null; then
                echo "python3"
                return 0
            fi
        fi
    fi
    
    return 1
}

# ==============================================================================
# UMU RETRY WRAPPER
# Wraps UMU invocations with retry logic for network failures
# (e.g., Steam Runtime download failures)
# ==============================================================================
run_umu_with_retry() {
    local python_bin="$1"
    local umu_path="$2"
    shift 2
    
    local max_attempts=3
    local attempt=1
    local wait_time=5
    local exit_code=0
    
    while [ $attempt -le $max_attempts ]; do
        log "[UMU] Attempt $attempt/$max_attempts..."
        
        # Run UMU command and capture the actual exit code
        # NOTE: $? after 'if cmd; then...; fi' is always 0 in bash (the compound
        # command's status), so we must capture the exit code directly.
        # Only redirect stderr — stdout must stay inherited so umu-run/pressure-vessel
        # see a real TTY (redirecting stdout changes container process behavior).
        "$python_bin" "$umu_path" "$@" 2>>"$LOG_FILE" && exit_code=0 || exit_code=$?
        
        if [ $exit_code -eq 0 ]; then
            return 0
        fi
        
        # If we still have retries left
        if [ $attempt -lt $max_attempts ]; then
            log "[UMU] Failed with exit code $exit_code, retrying in ${wait_time}s..."
            notify_stage "toasts.launcher.networkError" "toasts.launcher.retryingUmu|seconds=${wait_time}|attempt=$((attempt+1))|max=$max_attempts" "normal"
            
            # Only clean up Steam Runtime if it's actually broken (incomplete download).
            # If _v2-entry-point exists, steamrt3 is functional and the non-zero exit
            # code came from the game itself — retrying won't help, and deleting
            # steamrt3 would break all subsequent launches.
            if [ -d "$HOME/.local/share/umu" ]; then
                if [ ! -f "$HOME/.local/share/umu/steamrt3/_v2-entry-point" ]; then
                    log "[UMU] steamrt3 incomplete (missing _v2-entry-point), cleaning up..."
                    rm -rf "$HOME/.local/share/umu/steamrt3" 2>/dev/null || true
                    rm -rf "$HOME/.local/share/umu/umu_steam3" 2>/dev/null || true
                fi
                rm -f "$HOME/.local/share/umu/"*.parts 2>/dev/null || true
            fi
            
            sleep $wait_time
            wait_time=$((wait_time * 2))
        fi
        
        attempt=$((attempt + 1))
    done
    
    log "[UMU] All $max_attempts attempts failed (last exit code: $exit_code)"
    return $exit_code
}

# Restore Steam's LD_PRELOAD (filtered) before launching the actual game.
# This re-enables Steam Overlay and Steam Input for the game process.
restore_steam_env() {
    if [ -n "$STEAM_LD_PRELOAD" ]; then
        export LD_PRELOAD="$STEAM_LD_PRELOAD"
        log "[SteamEnv] Restored LD_PRELOAD for game process: $LD_PRELOAD"
    fi
}

# Wait for all Wine processes in the prefix to exit.
# Keep the launcher script alive while the game runs inside pressure-vessel.
# We ONLY read the process table via pgrep — we never run the host Proton's
# wineserver binary, which would conflict with the container's wineserver and
# corrupt the prefix (stale pfx.lock, socket collision, game won't start).
#
# Legendary exits immediately after spawning umu-run (Popen without wait),
# orphaning umu-run to PID 1.  The actual process tree is:
#   umu-run (python3) → steam-runtime-launch-client → bwrap → pv-adverb
#     → proton → wine → game.exe
# We wait for steam-runtime-launch-client (the long-lived container manager)
# because it stays alive for the entire game session and has a unique name.
wait_for_game_exit() {
    # Give umu-run / pressure-vessel a moment to fully start.
    # The container can take several seconds to register, especially on first
    # launch when Steam Runtime is being extracted.  Retry the detection check
    # multiple times before concluding there is nothing to wait for.
    local _detect_attempt=0
    local _detect_max=5
    local _found=false

    while [ $_detect_attempt -lt $_detect_max ]; do
        sleep 1
        if pgrep -f "steam-runtime-launch-client" >/dev/null 2>&1 || \
           pgrep -f "umu-run" >/dev/null 2>&1; then
            _found=true
            break
        fi
        _detect_attempt=$((_detect_attempt + 1))
    done

    if ! $_found; then
        log "[GameWait] No container processes found after ${_detect_max}s, skipping wait"
        return
    fi

    log "[GameWait] Game container detected, waiting for exit..."
    while pgrep -f "steam-runtime-launch-client" >/dev/null 2>&1 || \
          pgrep -f "umu-run" >/dev/null 2>&1; do
        sleep 1
    done
    log "[GameWait] Game container exited"
}

# ==============================================================================
# OFFLINE MODE DETECTION
# Detects Steam Offline Mode (via loginusers.vdf) or no internet connectivity
# ==============================================================================
detect_offline_mode() {
    # Method 1: Check Steam's loginusers.vdf for WantsOfflineMode
    local login_vdf="$HOME/.steam/steam/config/loginusers.vdf"
    if [ -f "$login_vdf" ]; then
        if grep -q '"WantsOfflineMode".*"1"' "$login_vdf" 2>/dev/null; then
            log "[Offline] Steam is in Offline Mode (loginusers.vdf)"
            return 0
        fi
    fi

    # Method 2: Quick network connectivity check (3s timeout)
    # ping may not be available on Steam Deck — fall back to curl
    if command -v ping &>/dev/null; then
        if ! ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1; then
            log "[Offline] No network connectivity detected (ping)"
            return 0
        fi
    elif ! curl -s --max-time 3 -o /dev/null https://epicgames.com 2>/dev/null; then
        log "[Offline] No network connectivity detected (curl)"
        return 0
    fi

    return 1
}

# ==============================================================================
# UNIFIDECK CONFIG READERS
# Read proton_settings.json and shortcuts_registry.json for Proton selection
# ==============================================================================

# Read saved Proton tool preference from proton_settings.json
# This is set by the frontend interceptor when it detects Force Compatibility
get_unifideck_proton_tool() {
    local game_key="$1"
    local config_file="$HOME/.local/share/unifideck/proton_settings.json"
    [ ! -f "$config_file" ] && return 1
    "$PYTHON_BIN" -c "
import json, sys
try:
    with open('$config_file') as f:
        data = json.load(f)
    tool = data.get('games', {}).get('$game_key', {}).get('proton_tool', '')
    if tool:
        print(tool)
except Exception:
    pass
" 2>/dev/null
}

# Read shortcut appID from shortcuts_registry.json for config.vdf lookup
get_shortcut_appid_from_registry() {
    local game_key="$1"
    local registry="$HOME/.local/share/unifideck/shortcuts_registry.json"
    [ ! -f "$registry" ] && return 1
    "$PYTHON_BIN" -c "
import json, sys
try:
    with open('$registry') as f:
        data = json.load(f)
    entry = data.get('$game_key', {})
    appid = entry.get('appid_unsigned')
    if appid:
        print(appid)
except Exception:
    pass
" 2>/dev/null
}

# ==============================================================================
# PROTON VERSION SELECTION
# Priority: 1) PROTONPATH= env  2) PROTON= env  2.5) Unifideck setting
#           3) Steam compat  4) default
# ==============================================================================

# Resolve a Proton tool name to its filesystem path
resolve_proton_path() {
    local proton_name="$1"
    
    # Check Steam common folders
    for base in "$HOME/.steam/steam/steamapps/common" \
                "$HOME/.local/share/Steam/steamapps/common" \
                "$HOME/.steam/root/steamapps/common"; do
        if [ -d "$base" ]; then
            case "$proton_name" in
                proton_experimental|"Proton - Experimental"|proton-experimental)
                    [ -d "$base/Proton - Experimental" ] && echo "$base/Proton - Experimental" && return 0 ;;
                proton_9|proton_90|proton9|"Proton 9"*|"proton-9"*|"Proton-9"*)
                    [ -d "$base/Proton 9.0 (Beta)" ] && echo "$base/Proton 9.0 (Beta)" && return 0 ;;
                proton_10|proton10|"Proton 10"*|"proton-10"*|"Proton-10"*)
                    [ -d "$base/Proton 10.0" ] && echo "$base/Proton 10.0" && return 0 ;;
            esac
        fi
    done
    
    # Check GE-Proton in compatibilitytools.d
    for compat_dir in "$HOME/.steam/root/compatibilitytools.d" \
                      "$HOME/.steam/steam/compatibilitytools.d" \
                      "$HOME/.local/share/Steam/compatibilitytools.d"; do
        local ge_path="$compat_dir/$proton_name"
        [ -d "$ge_path" ] && echo "$ge_path" && return 0
    done
    
    # Not found
    return 1
}

# Read Steam's compat tool setting for a given shortcut appID
get_steam_compat_tool() {
    local appid="$1"
    local config_vdf="$HOME/.steam/steam/config/config.vdf"
    
    [ ! -f "$config_vdf" ] && return 1
    [ -z "$appid" ] && return 1
    
    # Parse CompatToolMapping for this appid using grep+sed (more reliable than awk for VDF)
    # Look for the appid in CompatToolMapping section and extract the "name" value
    grep -A 5 "\"$appid\"" "$config_vdf" 2>/dev/null | \
        grep '"name"' | head -1 | \
        sed 's/.*"name"[[:space:]]*"\([^"]*\)".*/\1/'
}

# Main Proton selection function - called before game launch
select_proton_version() {
    local game_id="$1"
    local shortcut_appid="$2"
    local game_key="$3"

    # Priority 1: PROTONPATH already set in environment
    if [ -n "$PROTONPATH" ] && [ -d "$PROTONPATH" ]; then
        log "[Proton] Using PROTONPATH from environment: $PROTONPATH"
        return 0
    fi
    
    # Priority 2: PROTON= name in environment
    if [ -n "$PROTON" ]; then
        local resolved
        resolved=$(resolve_proton_path "$PROTON")
        if [ -n "$resolved" ]; then
            export PROTONPATH="$resolved"
            log "[Proton] Resolved PROTON=$PROTON to: $PROTONPATH"
            return 0
        else
            log "[Proton] PROTON=$PROTON not found locally. Attempting to install..."
            notify_stage "toasts.launcher.installingProton" "toasts.launcher.attemptingInstall|version=$PROTON" "normal"
            
            INSTALLER_SCRIPT="$PLUGIN_DIR/bin/proton_installer.py"
            if [ -f "$INSTALLER_SCRIPT" ]; then
                 # run installer
                 INSTALL_RESULT=$("$PYTHON_BIN" "$INSTALLER_SCRIPT" "$PROTON" 2>>"$LOG_FILE" | tail -n 1)
                 
                 if [ -n "$INSTALL_RESULT" ] && [ -d "$INSTALL_RESULT" ]; then
                     export PROTONPATH="$INSTALL_RESULT"
                     log "[Proton] Successfully installed to: $PROTONPATH"
                     return 0
                 elif [[ "$INSTALL_RESULT" == *"INSTALLED_VIA_STEAM"* ]]; then
                     log "[Proton] Steam installation completed. Re-resolving..."
                     resolved=$(resolve_proton_path "$PROTON")
                     if [ -n "$resolved" ]; then
                         export PROTONPATH="$resolved"
                         log "[Proton] Resolved new Steam Proton: $PROTONPATH"
                         return 0
                     fi
                 else
                     log "[Proton] Installation check failed or returned invalid path: $INSTALL_RESULT"
                 fi
            fi
            
            log "[Proton] WARNING: Could not resolve PROTON=$PROTON, using default"
        fi
    fi
    
    # Priority 2.5: Unifideck saved proton setting (from Steam's Force Compatibility UI)
    # The frontend interceptor extracts the compat tool and saves it to proton_settings.json
    if [ -n "$game_key" ]; then
        local unifideck_tool
        unifideck_tool=$(get_unifideck_proton_tool "$game_key" || true)
        if [ -n "$unifideck_tool" ]; then
            local resolved
            resolved=$(resolve_proton_path "$unifideck_tool")
            if [ -n "$resolved" ]; then
                export PROTONPATH="$resolved"
                log "[Proton] Using saved Unifideck setting ($unifideck_tool): $PROTONPATH"
                return 0
            else
                log "[Proton] Saved tool $unifideck_tool not found locally, attempting install..."
                notify_stage "toasts.launcher.installingProton" "toasts.launcher.attemptingInstall|version=$unifideck_tool" "normal"

                INSTALLER_SCRIPT="$PLUGIN_DIR/bin/proton_installer.py"
                if [ -f "$INSTALLER_SCRIPT" ]; then
                    INSTALL_RESULT=$("$PYTHON_BIN" "$INSTALLER_SCRIPT" "$unifideck_tool" 2>>"$LOG_FILE" | tail -n 1)

                    if [ -n "$INSTALL_RESULT" ] && [ -d "$INSTALL_RESULT" ]; then
                        export PROTONPATH="$INSTALL_RESULT"
                        log "[Proton] Installed $unifideck_tool to: $PROTONPATH"
                        return 0
                    elif [[ "$INSTALL_RESULT" == *"INSTALLED_VIA_STEAM"* ]]; then
                        log "[Proton] Steam installation completed. Re-resolving..."
                        resolved=$(resolve_proton_path "$unifideck_tool")
                        if [ -n "$resolved" ]; then
                            export PROTONPATH="$resolved"
                            log "[Proton] Resolved new Steam Proton: $PROTONPATH"
                            return 0
                        fi
                    else
                        log "[Proton] Installation failed for $unifideck_tool, falling through"
                    fi
                fi
            fi
        fi
    fi

    # Priority 3: Steam's Compatibility setting (direct config.vdf read)
    if [ -n "$shortcut_appid" ]; then
        local steam_tool
        steam_tool=$(get_steam_compat_tool "$shortcut_appid" || true)
        if [ -n "$steam_tool" ]; then
            local resolved
            resolved=$(resolve_proton_path "$steam_tool")
            if [ -n "$resolved" ]; then
                export PROTONPATH="$resolved"
                log "[Proton] Using Steam compat setting ($steam_tool): $PROTONPATH"
                return 0
            fi
        fi
    fi
    
    # Priority 4: Default - find any installed Proton (prefer Experimental > 10 > 9 > GE)
    for base in "$HOME/.steam/steam/steamapps/common" \
                "$HOME/.local/share/Steam/steamapps/common" \
                "$HOME/.steam/root/steamapps/common"; do
        if [ -d "$base/Proton - Experimental" ]; then
            export PROTONPATH="$base/Proton - Experimental"
            log "[Proton] Using default: Proton Experimental"
            return 0
        fi
        if [ -d "$base/Proton 10.0" ]; then
            export PROTONPATH="$base/Proton 10.0"
            log "[Proton] Using default: Proton 10.0"
            return 0
        fi
        if [ -d "$base/Proton 9.0 (Beta)" ]; then
            export PROTONPATH="$base/Proton 9.0 (Beta)"
            log "[Proton] Using default: Proton 9.0 (Beta)"
            return 0
        fi
    done

    # Also check GE-Proton in compatibilitytools.d
    for compat_dir in "$HOME/.steam/root/compatibilitytools.d" \
                      "$HOME/.steam/steam/compatibilitytools.d" \
                      "$HOME/.local/share/Steam/compatibilitytools.d"; do
        if [ -d "$compat_dir" ]; then
            local ge_proton
            ge_proton=$(ls -d "$compat_dir"/GE-Proton* 2>/dev/null | sort -rV | head -1)
            if [ -n "$ge_proton" ] && [ -d "$ge_proton" ]; then
                export PROTONPATH="$ge_proton"
                log "[Proton] Using default: $(basename "$ge_proton") (GE-Proton)"
                return 0
            fi
        fi
    done

    log "[Proton] No Proton found locally, umu will download one"
    return 0
}


# Find Python 3.10+ at startup
PYTHON_BIN=$(find_python310_plus)
if [ -z "$PYTHON_BIN" ]; then
    log "ERROR: Python 3.10+ not found! umu-launcher requires Python 3.10+"
    log "Available Python versions checked but none are 3.10+:"
    log "  Checked: /usr/bin/python3.1[0-3], ~/.local/bin/python3.1[0-3], python3"
    # Show user-friendly error using zenity if available
    if command -v zenity &>/dev/null; then
        zenity --error --title="Unifideck - Python Required" \
            --text="Python 3.10 or newer is required.\n\numu-launcher uses features only available in Python 3.10+.\n\nYour system Python version is too old.\n\nPlease install Python 3.10 or newer." \
            --width=400 2>/dev/null &
    fi
    exit 1
fi
log "Python 3.10+ found: $PYTHON_BIN"

# ==============================================================================
# PARSE LAUNCH OPTIONS FROM ANY POSITION
# Extracts VAR=value patterns from arguments and exports them as env variables.
# Handles standard vars (PROTON=, MANGOHUD=, DXVK_*=) as well as any other
# UPPER_SNAKE_CASE=value the user needs (e.g. PRESSURE_VESSEL_FILESYSTEMS_RW=,
# PROTON_REMOTE_DEBUG_CMD=, STEAM_COMPAT_MOUNTS=, etc.).
# Lowercase names (mangohud=1, lsfg=1) are also accepted and uppercased.
# ==============================================================================
KEY=""
EXTRA_ARGS=()

for arg in "$@"; do
    case "$arg" in
        # Store:id pattern - this is the game key (checked first — no = in it)
        epic:*|gog:*|amazon:*)
            KEY="$arg"
            ;;
        # Other arguments — check if it looks like a VAR=value env var
        *)
            if [[ "$arg" == *=* ]]; then
                var_name="${arg%%=*}"
                var_name_upper="${var_name^^}"
                # Accept any UPPER_SNAKE_CASE name (letters, digits, underscores, 2+ chars)
                # This covers PROTON_*, MANGOHUD, DXVK_*, PRESSURE_VESSEL_*, STEAM_*, etc.
                # Also accepts lowercase input (mangohud=1, lsfg=1) via ^^ uppercasing.
                if [[ "$var_name_upper" =~ ^[A-Z][A-Z0-9_]{1,}$ ]]; then
                    var_value="${arg#*=}"
                    export "$var_name_upper=$var_value"
                    log "[LaunchOptions] Parsed env: $var_name_upper=$var_value"
                else
                    # Not an env var (e.g. gamemoderun, ./script.sh=odd) — treat as arg
                    EXTRA_ARGS+=("$arg")
                fi
            else
                EXTRA_ARGS+=("$arg")
            fi
            ;;
    esac
done

if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
    log "[LaunchOptions] Extra game arguments: ${EXTRA_ARGS[*]}"
fi

# Split EXTRA_ARGS into WRAPPERS (before %command%) and GAME_ARGS (after %command%).
# Users can write launch options like "gamemoderun %command% --windowed" where:
#   - Tokens before %command% are wrapper binaries that prepend the game command
#   - Tokens after %command% are additional game arguments
#   - %command% itself is stripped (it represents the game command)
# If no %command% is found, all of EXTRA_ARGS becomes GAME_ARGS (backward compatible).
WRAPPERS=()
GAME_ARGS=()
_found_cmd=false
for arg in "${EXTRA_ARGS[@]}"; do
    if [ "$arg" = "%command%" ]; then
        _found_cmd=true
        continue
    fi
    # Strip Steam's "suppress default command" token — meaningless for non-Steam launchers
    [ "$arg" = "#%command%" ] && continue
    if $_found_cmd; then
        GAME_ARGS+=("$arg")
    else
        WRAPPERS+=("$arg")
    fi
done
if ! $_found_cmd; then
    # No %command% found — all extras become game args (backward compatible)
    # Still strip #%command% tokens
    GAME_ARGS=()
    for arg in "${EXTRA_ARGS[@]}"; do
        [ "$arg" = "#%command%" ] && continue
        GAME_ARGS+=("$arg")
    done
    WRAPPERS=()
fi

# Expand ~ in wrapper paths — bash doesn't expand tilde inside "${array[@]}",
# causing "No such file or directory" (exit 127) at launch time.
for i in "${!WRAPPERS[@]}"; do
    WRAPPERS[$i]="${WRAPPERS[$i]/#\~/$HOME}"
done

if [ ${#WRAPPERS[@]} -gt 0 ]; then
    log "[LaunchOptions] Wrapper commands: ${WRAPPERS[*]}"
fi
if [ ${#GAME_ARGS[@]} -gt 0 ]; then
    log "[LaunchOptions] Game arguments: ${GAME_ARGS[*]}"
fi

# 1. Validate game key
if [ -z "$KEY" ]; then
    log "ERROR: No game key provided"
    exit 1
fi

log "=== Launching: $KEY ==="

# 2. Look up in map file (with recovery for race conditions)
if [ ! -f "$MAP_FILE" ]; then
    log "WARNING: Map file not found at $MAP_FILE, waiting for backend to create it..."
    # Signal the plugin backend to rebuild the map
    touch "$HOME/.local/share/unifideck/.rebuild_map_requested" 2>/dev/null || true
    # Brief wait for the backend or a concurrent sync to create it
    sleep 2
    if [ ! -f "$MAP_FILE" ]; then
        log "ERROR: Map file still not found after recovery attempt"
        notify_stage "toasts.launcher.mapMissing" "toasts.launcher.syncRequired" "critical"
        if command -v zenity &>/dev/null; then
            zenity --error --title="Unifideck" --text="Game library not synced.\n\nPlease open the Unifideck plugin and run Sync Libraries, then try again." --width=350 2>/dev/null &
        fi
        exit 1
    fi
    log "Map file recovered at $MAP_FILE"
fi

# Find line starting with KEY|
GAME_ENTRY=$(grep "^$KEY|" "$MAP_FILE" | head -n 1)

if [ -z "$GAME_ENTRY" ]; then
    log "ERROR: Game not found in map for key: $KEY"
    # Show user-friendly error using zenity if available
    if command -v zenity &>/dev/null; then
        zenity --error --title="Unifideck" --text="Game location not mapped.\n\nPlease run Force Sync from the Unifideck plugin and try again." --width=350 2>/dev/null &
    fi
    exit 1
fi

# 3. Parse entry
# Format: key|exe|workdir
IFS='|' read -r _ EXE_PATH WORK_DIR <<< "$GAME_ENTRY"

if [ -z "$EXE_PATH" ]; then
    log "ERROR: No executable path in map entry"
    exit 1
fi

log "Executable: $EXE_PATH"
log "Work Dir: $WORK_DIR"

# 4. Check if executable exists
if [ ! -f "$EXE_PATH" ]; then
    log "ERROR: Executable not found: $EXE_PATH"
    if command -v zenity &>/dev/null; then
        zenity --error --title="Unifideck" --text="Game executable not found.\n\nThe game may have been uninstalled. Please reinstall." --width=350 2>/dev/null &
    fi
    exit 1
fi

# 5. Check if this is a Windows game (.exe, .cmd, .bat)
if [[ "$EXE_PATH" == *.exe ]] || [[ "$EXE_PATH" == *.EXE ]] || \
   [[ "$EXE_PATH" == *.cmd ]] || [[ "$EXE_PATH" == *.CMD ]] || \
   [[ "$EXE_PATH" == *.bat ]] || [[ "$EXE_PATH" == *.BAT ]]; then
    log "Windows game detected, using umu-launcher with Proton"
    
    # Parse store and game ID from key
    STORE="${KEY%%:*}"      # 'epic', 'gog', or 'amazon'
    GAME_ID="${KEY#*:}"     # Game ID after colon
    
    # Map store names to umu store codes
    case "$STORE" in
        epic)   UMU_STORE="egs" ;;
        gog)    UMU_STORE="gog" ;;
        amazon) UMU_STORE="amazon" ;;
        *)      UMU_STORE="none" ;;
    esac
    
    # ALWAYS use Unifideck's own prefix directory (complete isolation from Heroic)
    # This ensures we don't accidentally modify or depend on Heroic's data
    PREFIX_PATH="$PREFIXES_DIR/$GAME_ID"
    # Normalize accidental /pfx suffixes to keep a stable compat data root
    while [[ "$PREFIX_PATH" == */pfx ]]; do
        PREFIX_PATH="${PREFIX_PATH%/pfx}"
    done
    mkdir -p "$PREFIX_PATH"
    log "Using Unifideck prefix: $PREFIX_PATH"
    
    # UMU ID Lookup: Query the UMU API to get the correct GAMEID for ProtonFixes
    # This is the same approach Heroic uses to let umu-run apply game-specific fixes
    # Note: We use "|| true" because the script exits with code 1 when no ID is found
    UMU_LOOKUP_SCRIPT="$PLUGIN_DIR/bin/umu_lookup.py"
    UMU_ID=""
    if [ -f "$UMU_LOOKUP_SCRIPT" ]; then
        UMU_ID=$(python3 "$UMU_LOOKUP_SCRIPT" "$GAME_ID" "$UMU_STORE" 2>/dev/null || true)
        if [ -n "$UMU_ID" ]; then
            log "[UMU] Found umu_id: $UMU_ID (for $UMU_STORE:$GAME_ID)"
        else
            log "[UMU] No umu_id found for $UMU_STORE:$GAME_ID, using default"
        fi
    fi
    
    # Set umu environment variables (allow override via env vars for debugging)
    # Use UMU ID if found, otherwise fall back to umu-0 (no protonfixes).
    # Raw game IDs (e.g. Epic hashes) can trigger untested protonfixes that break games.
    export GAMEID="${GAMEID:-${UMU_ID:-umu-0}}"
    # Use umu-compatible store codes (egs/gog/amazon) — ProtonFixes doesn't recognize "epic"
    export STORE="$UMU_STORE"
    export STEAM_COMPAT_DATA_PATH="$PREFIX_PATH"
    
    
    # Select Proton version (respects PROTONPATH/PROTON env, Unifideck setting, Steam config, defaults)
    SHORTCUT_APPID=$(get_shortcut_appid_from_registry "$KEY" || true)
    select_proton_version "$GAME_ID" "$SHORTCUT_APPID" "$KEY"
    
    log "GAMEID: $GAMEID"
    log "STORE: $STORE"
    log "PROTONPATH: ${PROTONPATH:-<umu will download>}"

    # ===========================================================================
    # STEAM APP ID SETUP (for gamescope window matching)
    # Gamescope needs the STEAM_GAME X11 property on wine windows to match them
    # to the Steam game session and dismiss the loading screen.
    # umu-run's monitor_windows reads UMU_STEAM_GAME_ID from os.environ and
    # right-shifts by 32 to get the AppID. The 64-bit encoding for non-Steam
    # shortcuts is: (appid_unsigned << 32) | 0x02000000
    # ===========================================================================
    if [ -n "$SHORTCUT_APPID" ] && [ "$SHORTCUT_APPID" != "0" ]; then
        export SteamGameId="$SHORTCUT_APPID"
        export STEAM_COMPAT_APP_ID="$SHORTCUT_APPID"
        export SteamAppId="$SHORTCUT_APPID"
        # UMU_STEAM_GAME_ID: 64-bit encoded value that umu-run >> 32 to get AppID
        export UMU_STEAM_GAME_ID=$(python3 -c "print(($SHORTCUT_APPID << 32) | 0x02000000)")
        log "[SteamInput] Using shortcut AppID: $SHORTCUT_APPID (UMU_STEAM_GAME_ID=$UMU_STEAM_GAME_ID)"
    else
        export SteamGameId="0"
        export STEAM_COMPAT_APP_ID="0"
        export SteamAppId="0"
        export UMU_STEAM_GAME_ID="0"
        log "[SteamInput] WARNING: No shortcut AppID found (gamescope window matching may not work)"
    fi

    # ===========================================================================
    # PROTON VERSION COMPATIBILITY CHECK
    # Track which Proton version was used to create the prefix. If version changes
    # significantly, automatically reset the prefix to avoid compatibility issues.
    # ===========================================================================
    PREFIX_PFX="$PREFIX_PATH/pfx"
    ACTIVE_WINEPREFIX="$PREFIX_PFX"
    # Handle legacy/self-referential layouts where pfx points to prefix root.
    if [ -L "$PREFIX_PFX" ] && [ "$(readlink -f "$PREFIX_PFX")" = "$(readlink -f "$PREFIX_PATH")" ]; then
        log "[Prefix] Detected self-referential pfx symlink, using root prefix layout"
        ACTIVE_WINEPREFIX="$PREFIX_PATH"
    elif [ -f "$PREFIX_PATH/system.reg" ] && [ ! -f "$PREFIX_PFX/system.reg" ]; then
        # Legacy root layout (no pfx subtree)
        ACTIVE_WINEPREFIX="$PREFIX_PATH"
    fi
    export WINEPREFIX="$ACTIVE_WINEPREFIX"
    log "WINEPREFIX: $WINEPREFIX"
    PROTON_MARKER="$PREFIX_PATH/.unifideck_proton_version"
    
    # Get the current Proton version name (basename of PROTONPATH)
    if [ -n "$PROTONPATH" ]; then
        CURRENT_PROTON=$(basename "$PROTONPATH")
    else
        CURRENT_PROTON="default"
    fi
    
    # Check if prefix exists and has a different Proton version
    if [ -f "$PROTON_MARKER" ] && [ -d "$PREFIX_PFX" ]; then
        PREVIOUS_PROTON=$(cat "$PROTON_MARKER" 2>/dev/null || echo "unknown")
        
        if [ "$PREVIOUS_PROTON" != "$CURRENT_PROTON" ]; then
            log "[Proton] Version change detected: $PREVIOUS_PROTON -> $CURRENT_PROTON"
            
            # Check if this is a major version change (experimental <-> GE, or major version number change)
            NEED_RESET=false
            
            # Detect major family change (experimental vs GE-Proton vs Proton 9/10)
            case "$PREVIOUS_PROTON" in
                *Experimental*|*experimental*)
                    PREV_FAMILY="experimental" ;;
                GE-Proton*)
                    PREV_FAMILY="ge-proton" ;;
                *Proton\ 9*|*proton_9*|*proton9*)
                    PREV_FAMILY="proton9" ;;
                *Proton\ 10*|*proton_10*|*proton10*)
                    PREV_FAMILY="proton10" ;;
                *)
                    PREV_FAMILY="other" ;;
            esac
            
            case "$CURRENT_PROTON" in
                *Experimental*|*experimental*)
                    CURR_FAMILY="experimental" ;;
                GE-Proton*)
                    CURR_FAMILY="ge-proton" ;;
                *Proton\ 9*|*proton_9*|*proton9*)
                    CURR_FAMILY="proton9" ;;
                *Proton\ 10*|*proton_10*|*proton10*)
                    CURR_FAMILY="proton10" ;;
                *)
                    CURR_FAMILY="other" ;;
            esac
            
            if [ "$PREV_FAMILY" != "$CURR_FAMILY" ]; then
                NEED_RESET=true
                log "[Proton] Major version family change: $PREV_FAMILY -> $CURR_FAMILY"
            fi
            
            if [ "$NEED_RESET" = true ]; then
                log "[Proton] Resetting prefix for compatibility with new Proton version..."
                notify_stage "toasts.launcher.protonUpgrade" "toasts.launcher.resettingPrefix|version=$CURRENT_PROTON" "normal"
                
                # Backup save data if it exists
                SAVE_BACKUP=""
                if [ -d "$PREFIX_PFX/drive_c/users" ]; then
                    SAVE_BACKUP="$PREFIX_PATH/.save_backup_$$"
                    log "[Proton] Backing up user data..."
                    cp -r "$PREFIX_PFX/drive_c/users" "$SAVE_BACKUP" 2>/dev/null || true
                fi
                
                # Remove the prefix and all installation markers
                rm -rf "$PREFIX_PFX" 2>/dev/null || true
                rm -f "$PREFIX_PATH/unifideck_winetricks_complete.marker" 2>/dev/null || true
                rm -f "$PREFIX_PATH/.unifideck_prereqs_"*.done 2>/dev/null || true
                rm -f "$PREFIX_PATH/.unifideck-gog-setup-done" 2>/dev/null || true

                log "[Proton] Prefix cleared, will be recreated on launch"
                
                # Note: save backup is kept at $SAVE_BACKUP if needed
                # A more sophisticated solution would restore specific save folders
            else
                log "[Proton] Minor version change, keeping prefix (Proton will upgrade it)"
            fi
        fi
    fi
    
    # Update the proton version marker
    mkdir -p "$PREFIX_PATH"
    echo "$CURRENT_PROTON" > "$PROTON_MARKER"
    
    # ===========================================================================
    # SYNCHRONOUS PREFIX INITIALIZATION
    # Ensure prefix is fully ready before launching game (like Heroic/Steam)
    # ===========================================================================
    SYSTEM_REG="$ACTIVE_WINEPREFIX/system.reg"

    
    if [ ! -f "$SYSTEM_REG" ]; then
        log "[FirstLaunch] Prefix not initialized (no system.reg), running setup..."
        notify_stage "toasts.launcher.firstTimeSetup" "toasts.launcher.initializingPrefix" "normal"
        
        # Ensure prefix directory exists
        mkdir -p "$PREFIX_PATH"
        # Prefer modern Proton layout for newly created prefixes
        if [ "$ACTIVE_WINEPREFIX" != "$PREFIX_PATH" ]; then
            mkdir -p "$ACTIVE_WINEPREFIX"
        fi
        
        # Find umu-run path for createprefix
        if [ -f "$UMU_RUN" ]; then
            SETUP_UMU="$UMU_RUN"
        elif command -v umu-run &>/dev/null; then
            SETUP_UMU="umu-run"
        else
            log "ERROR: umu-run not found for prefix setup"
            exit 1
        fi
        
        log "[FirstLaunch] Running createprefix with umu-run (this may take 1-2 minutes)..."
        
        # Run createprefix with retry logic for network resilience (Steam Runtime download).
        # NOTE: Proton returns non-zero for createprefix even on success because it
        # tries to "run" the createprefix keyword as a program. We check for
        # system.reg to confirm success instead of relying on the exit code.
        # IMPORTANT: Do NOT use 'local' here — this is not inside a function.
        # 'local' outside a function errors in bash and set -e kills the script.
        _cp_attempt=1
        _cp_max=3
        _cp_wait=5
        while [ $_cp_attempt -le $_cp_max ]; do
            log "[UMU] Attempt $_cp_attempt/$_cp_max..."
            "$PYTHON_BIN" "$SETUP_UMU" createprefix >>"$LOG_FILE" 2>&1 || true
            
            if [ -f "$SYSTEM_REG" ]; then
                log "[FirstLaunch] Prefix created successfully"
                notify_stage "toasts.launcher.setupCompleteTitle" "toasts.launcher.prefixInitialized" "low"
                break
            fi
            
            if [ $_cp_attempt -lt $_cp_max ]; then
                log "[FirstLaunch] system.reg not found after attempt $_cp_attempt, retrying in ${_cp_wait}s..."
                notify_stage "toasts.launcher.networkError" "toasts.launcher.retryingUmu|seconds=${_cp_wait}|attempt=$((_cp_attempt+1))|max=$_cp_max" "normal"
                # Clean up partial Steam Runtime downloads
                rm -rf "$HOME/.local/share/umu/steamrt3" 2>/dev/null || true
                rm -rf "$HOME/.local/share/umu/umu_steam3" 2>/dev/null || true
                rm -f "$HOME/.local/share/umu/"*.parts 2>/dev/null || true
                sleep $_cp_wait
                _cp_wait=$((_cp_wait * 2))
            fi
            _cp_attempt=$((_cp_attempt + 1))
        done
        
        # Final verification
        if [ ! -f "$SYSTEM_REG" ]; then
            log "[FirstLaunch] WARNING: system.reg still missing after $_cp_max attempts"
            # Last-resort fallback: wineboot
            log "[FirstLaunch] Trying wineboot --init as fallback..."
            notify_stage "toasts.launcher.setupFallback" "toasts.launcher.fallbackInitialization" "normal"
            "$PYTHON_BIN" "$SETUP_UMU" wineboot --init >>"$LOG_FILE" 2>&1 || true
            if [ -f "$SYSTEM_REG" ]; then
                log "[FirstLaunch] wineboot fallback succeeded"
            else
                log "WARNING: system.reg still missing after all attempts, game may fail"
            fi
        else
            log "[FirstLaunch] Verified: system.reg exists, prefix is ready"
        fi
    else
        log "[FirstLaunch] Prefix already initialized (system.reg exists)"
    fi
    
    # Check for umu-run
    if [ ! -f "$UMU_RUN" ]; then
        log "ERROR: umu-run not found at $UMU_RUN"
        exit 1
    fi

    
    # Change to work directory
    if [ -d "$WORK_DIR" ]; then
        cd "$WORK_DIR"
        log "Changed to: $WORK_DIR"
    fi
    
    # Launch with umu as wrapper via legendary (Heroic approach)
    
    # For Epic games, we now use legendary to launch (like Heroic does)
    # This ensures proper Epic authentication and wrapper handling
    if [ "$STORE" == "epic" ] || [ "$STORE" == "egs" ]; then
        log "Launching Epic game via legendary..."

        # Detect offline mode (Steam Offline Mode or no internet)
        IS_OFFLINE=false
        if detect_offline_mode; then
            IS_OFFLINE=true
            log "[Epic] Offline mode detected - will pass --offline to legendary"
        fi
        
        # PREFER Bundled Legendary binary (v0.20.38+) which has LEGENDARY_WRAPPER_EXE support
        # We now download this during build, so checks for Heroic's binary are secondary/fallback
        LEGENDARY_BIN="$PLUGIN_DIR/bin/legendary"
        
        if [ -f "$LEGENDARY_BIN" ]; then
             log "Using Bundled legendary binary (should have WRAPPER_EXE support): $LEGENDARY_BIN"
        else
             # Fallback to finding Heroic's binary if bundled one is missing
             HEROIC_LEGENDARY_BIN=$(find /var/lib/flatpak/app/com.heroicgameslauncher.hgl -name "legendary" -path "*/linux/*" 2>/dev/null | head -1)
             if [ -f "$HEROIC_LEGENDARY_BIN" ]; then
                LEGENDARY_BIN="$HEROIC_LEGENDARY_BIN"
                log "Using External (Heroic) legendary binary: $LEGENDARY_BIN"
             fi
        fi

        if [ ! -f "$LEGENDARY_BIN" ]; then
            log "ERROR: legendary binary not found"
            if command -v zenity &>/dev/null; then
                zenity --error --title="Unifideck" --text="Legendary binary not found.\n\nPlease reinstall Unifideck plugin." --width=350 2>/dev/null &
            fi
            exit 1
        fi

        # Set additional environment variables (matching Heroic's exact config)
        # NOTE: GAMEID is already set correctly (line ~675) from UMU API lookup or game ID fallback.
        # Do NOT override to umu-0 here — that disables game-specific ProtonFixes.
        # Utility scripts (winetricks, prerequisites) set their own GAMEID=umu-0 internally.
        export STEAM_COMPAT_INSTALL_PATH="$WORK_DIR"
        export HEROIC_APP_NAME="$GAME_ID"
        export HEROIC_APP_RUNNER="legendary"
        export HEROIC_APP_SOURCE="epic"

        # NOTE: SteamAppId/SteamGameId/STEAM_COMPAT_APP_ID/UMU_STEAM_GAME_ID are now
        # set in the common section above (before Epic/GOG/Amazon branching).

        # Enable NVAPI for modern Proton
        export PROTON_ENABLE_NVAPI="1"
        export DXVK_NVAPI_ALLOW_OTHER_DRIVERS="1"


        log "STEAM_COMPAT_INSTALL_PATH: $STEAM_COMPAT_INSTALL_PATH"
        log "GAMEID: $GAMEID"

        # Choose Legendary Config Path (Critical for Epic Auth AND EOS overlay)
        # Must be set BEFORE eos-overlay install/enable — legendary needs this
        # to find overlay_install.json and write the OverlayPath registry key.
        if [ -f "$HOME/.config/legendary/user.json" ]; then
            export LEGENDARY_CONFIG_PATH="$HOME/.config/legendary"
            log "Using local LEGENDARY_CONFIG_PATH: $LEGENDARY_CONFIG_PATH"
        elif [ -f "$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/legendaryConfig/legendary/user.json" ]; then
            export LEGENDARY_CONFIG_PATH="$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/legendaryConfig/legendary"
            log "Using External LEGENDARY_CONFIG_PATH: $LEGENDARY_CONFIG_PATH"
        else
            log "WARNING: No authenticated Legendary config found! Game may fail to launch."
            notify_stage "toasts.launcher.epicAuthRequired" "toasts.launcher.epicAuthRequiredMessage" "critical"
        fi

        # Install/Update EOS overlay if not installed (required for games like FM24)
        # Check if overlay_install.json exists in legendary config
        EOS_INSTALL_MARKER="$HOME/.config/legendary/overlay_install.json"
        if [ ! -f "$EOS_INSTALL_MARKER" ]; then
            log "EOS Overlay not installed, installing..."
            "$LEGENDARY_BIN" eos-overlay install -y 2>>"$LOG_FILE" || true
        else
            # Update to latest version (non-blocking, best effort)
            "$LEGENDARY_BIN" eos-overlay update -y 2>>"$LOG_FILE" &
            EOS_UPDATE_PID=$!
        fi

        # Enable EOS overlay for the /pfx subdirectory (like Heroic)
        # Only if prefix is already initialized (has user.reg)
        if [ -f "$ACTIVE_WINEPREFIX/user.reg" ]; then
            "$LEGENDARY_BIN" eos-overlay enable --prefix "$ACTIVE_WINEPREFIX" 2>>"$LOG_FILE" || true

            # legendary only writes the OverlayPath to user.reg (HKCU).
            # Some EOS SDK builds also probe HKLM, so mirror the key into
            # system.reg as a safety net — pure text, no wineserver spawned.
            _OVERLAY_PATH=""
            if [ -f "$LEGENDARY_CONFIG_PATH/overlay_install.json" ]; then
                _OVERLAY_PATH=$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print('Z:'+d.get('install_path',''))" "$LEGENDARY_CONFIG_PATH/overlay_install.json" 2>/dev/null || true)
            fi
            if [ -n "$_OVERLAY_PATH" ] && [ -f "$ACTIVE_WINEPREFIX/system.reg" ]; then
                _EOS_KEY_LINE="\"OverlayPath\"=\"${_OVERLAY_PATH//\\/\/}\""
                if ! grep -q 'Epic Games.*EOS.*OverlayPath' "$ACTIVE_WINEPREFIX/system.reg" 2>/dev/null; then
                    log "[EOS] Adding OverlayPath to system.reg (HKLM) for SDK compatibility"
                    printf '\n[Software\\\\Epic Games\\\\EOS] %s\n#time=1dca63a02c1ccb0\n%s\n' \
                        "$(date +%s)" "$_EOS_KEY_LINE" >> "$ACTIVE_WINEPREFIX/system.reg"
                fi
            fi
        else
            log "Prefix not initialized yet, skipping EOS overlay enable"
        fi

        # === WINETRICKS: Install redistributables at first launch ===
        # Check if winetricks was already run successfully
        WINETRICKS_MARKER="$PREFIX_PATH/unifideck_winetricks_complete.marker"
        WINETRICKS_SCRIPT="$PLUGIN_DIR/bin/winetricks_installer.py"

        if [ ! -f "$WINETRICKS_MARKER" ] || ! grep -qi "complete\|no redistributables\|failed" "$WINETRICKS_MARKER" 2>/dev/null; then
            if [ -f "$WINETRICKS_SCRIPT" ]; then
                log "[Winetricks] Running first-launch redistributables installation..."
                notify_stage "toasts.launcher.dependenciesTitle" "toasts.launcher.installingRedistributables" "normal"
                
                # Run SYNCHRONOUSLY - blocks until complete
                if python3 "$WINETRICKS_SCRIPT" "$GAME_ID" "$PREFIX_PATH" >> "$HOME/.local/share/unifideck/winetricks.log" 2>&1; then
                    log "[Winetricks] Installation completed successfully"
                    notify_stage "toasts.launcher.dependenciesReady" "toasts.launcher.redistributablesInstalled" "low"
                else
                    log "[Winetricks] Installation completed (may have warnings)"
                    notify_stage "toasts.launcher.dependenciesStatus" "toasts.launcher.checkLogs" "low"
                fi
            fi
        else
            log "[Winetricks] Redistributables already installed, skipping"
        fi

        # === PREREQUISITES: Install game-specific prerequisites (e.g., Ubisoft Connect) ===
        # This mirrors Heroic's legendarySetup which reads prereq_info from legendary metadata
        # and runs the installer (e.g., UplayInstaller.exe /S) inside the prefix.
        PREREQ_SCRIPT="$PLUGIN_DIR/bin/epic_prerequisites.py"
        PREREQ_MARKER_GLOB="$PREFIX_PATH/.unifideck_prereqs_${GAME_ID}"

        if [ -f "$PREREQ_SCRIPT" ] && ! ls "${PREREQ_MARKER_GLOB}"*.done 1>/dev/null 2>&1; then
            log "[Prerequisites] Checking for game prerequisites..."
            notify_stage "toasts.launcher.prerequisitesTitle" "toasts.launcher.installingPrerequisites" "normal"

            if python3 "$PREREQ_SCRIPT" "$GAME_ID" "$PREFIX_PATH" >> "$LOG_FILE" 2>&1; then
                log "[Prerequisites] Installation completed"
                notify_stage "toasts.launcher.prerequisitesReady" "toasts.launcher.prerequisitesInstalled" "low"
            else
                log "[Prerequisites] Installation failed (game may still work)"
                notify_stage "toasts.launcher.prerequisitesFailed" "toasts.launcher.prerequisitesFailedMessage" "normal"
            fi
        else
            log "[Prerequisites] Already installed or no script found, skipping"
        fi

        # Get the umu-run path
        # PREFER bundled umu-run - Heroic's flatpak uses Python 3.9 which causes
        # SyntaxError on match statements in newer umu versions
        if [ -f "$UMU_RUN" ]; then
            UMU_WRAPPER="$UMU_RUN"
            log "Using bundled umu-run: $UMU_WRAPPER"
        elif [ -f "$HEROIC_UMU_RUN" ]; then
            UMU_WRAPPER="$HEROIC_UMU_RUN"
            log "Using External (Shared) umu-run: $UMU_WRAPPER"
        elif command -v umu-run &>/dev/null; then
            UMU_WRAPPER="umu-run"
             log "Using system umu-run"
        else
             log "ERROR: umu-run not found"
             exit 1
        fi

        # Python path is already set at startup with version verification (PYTHON_BIN)
        log "Using Python (verified 3.10+): $PYTHON_BIN"

        # (LEGENDARY_CONFIG_PATH already set above, before EOS overlay block)

        # === LANGUAGE: Read Unifideck language preference for Epic launch ===
        EPIC_LANG="en"
        SETTINGS_FILE="$HOME/.local/share/unifideck/settings.json"
        if [ -f "$SETTINGS_FILE" ]; then
            RAW_LANG=$(python3 -c "import json; print(json.load(open('$SETTINGS_FILE')).get('language', 'auto'))" 2>/dev/null || echo "auto")
            if [ "$RAW_LANG" != "auto" ] && [ -n "$RAW_LANG" ]; then
                # Extract 2-letter code: "en-US" -> "en", "de-DE" -> "de"
                EPIC_LANG=$(echo "$RAW_LANG" | cut -d'-' -f1)
                log "[Language] Using Unifideck language for Epic: $EPIC_LANG (from $RAW_LANG)"
            else
                log "[Language] Unifideck language set to auto, defaulting to: $EPIC_LANG"
            fi
        else
            log "[Language] No Unifideck settings found, defaulting to: $EPIC_LANG"
        fi

        # === UBISOFT CONNECT NATIVE BYPASS & SELF-HEALING ===
        # 1. Self-Healing for renamed executables (from old wrapper.c workarounds)
        ORIG_EXE="$WORK_DIR/UplayLaunch.orig.exe"
        if [ -f "$ORIG_EXE" ]; then
            log "[Uplay] Found UplayLaunch.orig.exe. Restoring to UplayLaunch.exe to fix sync map..."
            mv "$ORIG_EXE" "$WORK_DIR/UplayLaunch.exe" 2>/dev/null || true
        fi
        
        # 2. Check installed.json for Ubisoft integration
        # Ubisoft is an exception path: launcher/manifest-based detection only.
        INSTALLED_JSON="$LEGENDARY_CONFIG_PATH/installed.json"
        IS_UBISOFT="false"
        UPLAY_ID=""
        
        if [ -f "$INSTALLED_JSON" ]; then
            UBI_RESULT=$(python3 -c "
import json, re
result = 'false|'
try:
    with open('$INSTALLED_JSON', 'r') as f:
        data = json.load(f)
    app = data.get('$GAME_ID') or {}
    exe = (app.get('executable') or '').lower()
    params = app.get('launch_parameters') or ''
    prereq = app.get('prereq_info') or {}
    prereq_path = (prereq.get('path') or '').lower()
    prereq_name = (prereq.get('name') or '').lower()
    prereq_ids = ' '.join(str(x).lower() for x in (prereq.get('ids') or []))

    launcher_hit = ('uplaylaunch.exe' in exe) or ('ubisoft' in exe) or ('uplay' in exe)
    manifest_hit = ('uplay' in params.lower()) or ('uplay' in prereq_path) or ('ubisoft' in prereq_name) or ('uplay' in prereq_ids)

    m = re.search(r'-UplayId=\\s*(\\d+)', params)
    uplay_id = m.group(1) if m else ''

    if launcher_hit or manifest_hit:
        result = f'true|{uplay_id}'
except Exception:
    pass
print(result)
" 2>/dev/null)
            IFS='|' read -r UBI_HIT UBI_ID <<< "$UBI_RESULT"
            if [ "$UBI_HIT" = "true" ]; then
                IS_UBISOFT="true"
                UPLAY_ID="$UBI_ID"
                log "[Uplay] Detected Ubisoft title from launcher/manifest metadata (UplayId: ${UPLAY_ID:-unknown})"
            fi
        fi

        # Construct the launch command
        OFFLINE_FLAG=""
        if [ "$IS_OFFLINE" = true ]; then
            OFFLINE_FLAG="--offline"
        fi
        
        if [ "$IS_UBISOFT" = "true" ]; then
            # === UBISOFT-ONLY: Copy wrapper + apply registry ===
            # These artifacts (EpicGamesLauncher.exe in PATH, com.epicgames.launcher
            # registry key) are needed for Ubisoft Connect's Epic SSO flow.
            # They MUST NOT be applied to non-Ubisoft games — the EOS SDK finds them
            # and switches to launcher-IPC auth mode, causing instant exit (code 0).
            FIX_SCRIPT="$PLUGIN_DIR/bin/fix_epic_launcher_prefix.py"
            if [ -f "$FIX_SCRIPT" ]; then
                 log "[Uplay] Applying Epic launcher wrapper fix for Ubisoft title..."
                 python3 "$FIX_SCRIPT" "$PREFIX_PATH" >> "$LOG_FILE" 2>&1 || true
            fi

            # Inject Epic + Ubisoft registry keys into the pfx/ subdirectory
            # (critical: Proton reads registry from pfx/, not the parent prefix)
            REGISTRY_SCRIPT="$PLUGIN_DIR/bin/epic_registry_setup.py"
            if python3 "$REGISTRY_SCRIPT" "$GAME_ID" "$PREFIX_PATH" "$LEGENDARY_CONFIG_PATH" >> "$LOG_FILE" 2>&1; then
                log "[Uplay] Registry keys injected into pfx successfully."
            else
                log "[Uplay] WARNING: Registry injection failed. Game may prompt for install."
            fi

            # Launch upc.exe directly — bypasses Epic SSO entirely
            # Relies on linked accounts (server-side verify) and pfx/ registry injection
            export PROTON_VERB="waitforexitandrun"
            UPC_EXE="$ACTIVE_WINEPREFIX/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/upc.exe"
            if [ ! -f "$UPC_EXE" ]; then
                 UPC_EXE="$PREFIX_PATH/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/upc.exe"
            fi

            if [ -f "$UPC_EXE" ] && [ -n "$UPLAY_ID" ]; then
                CMD_STR="\"$PYTHON_BIN\" \"$UMU_WRAPPER\" \"$UPC_EXE\" \"uplay://launch/$UPLAY_ID/0\""
                log "[Uplay] Launching upc.exe directly: uplay://launch/$UPLAY_ID/0"
            else
                log "[Uplay] WARNING: direct Ubisoft launch prerequisites missing (upc.exe or UplayId). Falling back to Legendary."
                IS_UBISOFT="false"
                export LEGENDARY_WRAPPER_EXE="C:\\windows\\command\\EpicGamesLauncher.exe"
                CMD_STR="${WRAPPERS[@]:+${WRAPPERS[*]} }$LEGENDARY_BIN launch $GAME_ID --no-wine --skip-version-check $OFFLINE_FLAG --wrapper \"$PYTHON_BIN $UMU_WRAPPER\" --language $EPIC_LANG${GAME_ARGS[@]:+ -- ${GAME_ARGS[*]}}"
            fi
        else
            # Standard Epic path for non-Ubisoft titles
            # NOTE: Do NOT set LEGENDARY_WRAPPER_EXE here! When set, legendary
            # passes the wrapper stub as args[0] to umu-run instead of the real
            # game exe, so the stub runs and exits instantly — the game never
            # launches.
            unset LEGENDARY_WRAPPER_EXE
            export PROTON_VERB="waitforexitandrun"

            # Override STORE to prevent ProtonFixes EGS defaults from running.
            # The EGS default fix does two harmful things:
            #   1. protontricks('vcrun2022') — core-dumps inside pressure-vessel
            #   2. regedit_add('HKCR\\com.epicgames.launcher') — adds a registry
            #      key that makes EOS SDK switch to launcher-IPC auth, causing
            #      instant exit for non-Ubisoft games.
            # Unifideck handles redistributables separately (winetricks_installer.py)
            # and EOS overlay (legendary eos-overlay enable), so EGS defaults are
            # not needed and actively break non-Ubisoft titles.
            export STORE="none"

            # === LAZY CLEANUP: Remove Ubisoft wrapper artifacts from prefix ===
            # Previous versions ran fix_epic_launcher_prefix.py on ALL Epic games,
            # placing EpicGamesLauncher.exe in windows/command/ (Wine PATH) and
            # creating a com.epicgames.launcher registry key. The EOS SDK finds these,
            # switches to launcher-IPC auth, the stub doesn't respond, and the game
            # exits with code 0. Clean them up so tainted prefixes self-heal.
            for _dc in "$ACTIVE_WINEPREFIX/drive_c" "$PREFIX_PATH/drive_c"; do
                if [ -d "$_dc" ]; then
                    rm -f "$_dc/windows/command/EpicGamesLauncher.exe" 2>/dev/null || true
                    rm -f "$_dc/Program Files (x86)/Epic Games/Launcher/Portal/Binaries/Win32/EpicGamesLauncher.exe" 2>/dev/null || true
                fi
            done
            # Remove the hollow registry key that signals "launcher installed" to EOS SDK.
            # Use sed on the registry files directly — do NOT spawn wine/wineserver here,
            # as that creates process contention with the subsequent umu-run launch.
            for _reg in "$ACTIVE_WINEPREFIX/user.reg" "$ACTIVE_WINEPREFIX/system.reg"; do
                if [ -f "$_reg" ] && grep -q 'com\.epicgames\.launcher' "$_reg" 2>/dev/null; then
                    # Remove the [HKEY_CLASSES_ROOT\\com.epicgames.launcher] section and its values
                    sed -i '/^\[.*com\.epicgames\.launcher\]/,/^\[/{ /^\[.*com\.epicgames\.launcher\]/d; /^\[/!d; }' "$_reg" 2>/dev/null || true
                    log "[Cleanup] Removed com.epicgames.launcher from $(basename "$_reg")"
                fi
            done
            CMD_STR="${WRAPPERS[@]:+${WRAPPERS[*]} }$LEGENDARY_BIN launch $GAME_ID --no-wine --skip-version-check $OFFLINE_FLAG --wrapper \"$PYTHON_BIN $UMU_WRAPPER\" --language $EPIC_LANG${GAME_ARGS[@]:+ -- ${GAME_ARGS[*]}}"
        fi

        log "Executing: $CMD_STR"
        log "IS_UBISOFT: $IS_UBISOFT"
        log "LEGENDARY_WRAPPER_EXE: ${LEGENDARY_WRAPPER_EXE:-<unset>}"
        log "PROTON_VERB: $PROTON_VERB"
        log "STORE: $STORE"

        # === CLOUD SAVE: Download before launch ===
        if [ "$IS_OFFLINE" = true ]; then
            log "[CloudSave] Offline mode - skipping pre-launch sync"
        else
            sync_cloud_saves "epic" "$GAME_ID" "download" "$PREFIX_PATH"
        fi

        # Clean up background EOS overlay update if still running
        if [ -n "$EOS_UPDATE_PID" ]; then
            kill "$EOS_UPDATE_PID" 2>/dev/null || true
            wait "$EOS_UPDATE_PID" 2>/dev/null || true
        fi

        # Notify user that game is launching
        if [ "$IS_UBISOFT" = "true" ]; then
             notify_stage "toasts.launcher.launchingGame" "Starting Ubisoft Connect..." "low"
        else
             notify_stage "toasts.launcher.launchingGame" "toasts.launcher.startingEpicGame" "low"
        fi

        # DO NOT restore Steam's LD_PRELOAD here.
        # All umu-run launches go through pressure-vessel (a container) which has
        # its own Steam overlay mechanism.  Re-exporting the host's
        # gameoverlayrenderer.so via LD_PRELOAD causes "cannot be preloaded"
        # errors and can crash/early-exit the game process.  The working version
        # (commit 711adbf) simply unset LD_PRELOAD at startup and never restored
        # it — we follow that same approach for Epic launches.

        # Execute launch command (capture exit code explicitly to avoid set -e
        # killing the script on non-zero game exits, skipping cleanup/cloud saves)
        # NOTE: Only redirect stderr to log. Stdout must stay inherited (TTY) because
        # legendary's Popen passes FDs to umu-run/pressure-vessel — if stdout points
        # to a file instead of a TTY, container process management may change.
        if [ "$IS_UBISOFT" = "true" ]; then
             eval "$CMD_STR" 2>>"$LOG_FILE" && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?
        else
             "${WRAPPERS[@]}" "$LEGENDARY_BIN" launch "$GAME_ID" --no-wine --skip-version-check $OFFLINE_FLAG \
                 --wrapper "$PYTHON_BIN $UMU_WRAPPER" --language $EPIC_LANG \
                 ${GAME_ARGS[@]:+-- "${GAME_ARGS[@]}"} 2>>"$LOG_FILE" \
                 && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?
        fi

        # Legendary returns before the game/container fully exits.
        # Keep the script alive so Steam shows "Running" for the correct duration
        # and cloud-save upload runs AFTER the game truly exits.
        wait_for_game_exit

        # === CLOUD SAVE: Upload after exit ===
        # NOTE: GAME_EXIT_CODE is legendary's exit code, not the game's.
        # Legendary spawns umu-run via Popen without wait(), so it almost always returns 0.
        # The actual game exit happens inside the container (waited by wait_for_game_exit above).
        log "Epic game session ended (legendary exit code: $GAME_EXIT_CODE)"
        if [ "$IS_OFFLINE" = true ]; then
            log "[CloudSave] Offline mode - skipping post-launch sync"
        else
            sync_cloud_saves "epic" "$GAME_ID" "upload" "$PREFIX_PATH"
        fi

        exit $GAME_EXIT_CODE
    elif [ "$STORE" == "amazon" ]; then
        # Amazon games may need fuel.json parsing for additional launch parameters
        log "Amazon game detected, checking for fuel.json..."

        # Find fuel.json in game directory
        FUEL_JSON="$WORK_DIR/fuel.json"
        AMAZON_ARGS=""
        if [ -f "$FUEL_JSON" ]; then
            log "Found fuel.json at $FUEL_JSON"

            # Parse launch args from fuel.json if present
            AMAZON_ARGS=$(python3 -c "import json, re, sys
try:
    with open(sys.argv[1], 'r') as f:
        content = f.read()
        # Remove single-line comments (fuel.json may have them)
        content = re.sub(r'//.*$', '', content, flags=re.MULTILINE)
        data = json.loads(content)
        main = data.get('Main', {})
        args = main.get('Args', [])
        if args:
            print(' '.join(f'\"{arg}\"' for arg in args))
except Exception as e:
    print('', file=sys.stderr)
" "$FUEL_JSON" 2>> "$LOG_FILE" || true)
            log "Obtained Amazon args: $AMAZON_ARGS"
        else
            log "No fuel.json found, launching without additional args"
        fi

        # Determine Python path - need Python 3.10+ for modern umu-launcher
        PYTHON_BIN=""
        for py in /usr/bin/python3.13 /usr/bin/python3.12 /usr/bin/python3.11 /usr/bin/python3.10 /usr/bin/python3; do
            if [ -x "$py" ]; then
                PYTHON_BIN="$py"
                break
            fi
        done
        if [ -z "$PYTHON_BIN" ]; then
            PYTHON_BIN="python3"
        fi
        log "Using Python: $PYTHON_BIN"

        # Get the umu-run path
        if [ -f "$UMU_RUN" ]; then
            UMU_WRAPPER="$UMU_RUN"
            log "Using bundled umu-run: $UMU_WRAPPER"
        elif command -v umu-run &>/dev/null; then
            UMU_WRAPPER="umu-run"
            log "Using system umu-run"
        else
            log "ERROR: umu-run not found"
            exit 1
        fi

        # === LANGUAGE: Set Windows locale in prefix for Amazon games ===
        AMAZON_LANG_SCRIPT="$PLUGIN_DIR/bin/amazon_set_language.py"
        if [ -f "$AMAZON_LANG_SCRIPT" ]; then
            log "[Language] Setting Windows locale for Amazon game..."
            python3 "$AMAZON_LANG_SCRIPT" "$PREFIX_PATH" >> "$LOG_FILE" 2>&1 || true
        fi

        # Build the command with any Amazon-specific args
        if [ -n "$AMAZON_ARGS" ]; then
            CMD_STR="$PYTHON_BIN $UMU_WRAPPER \"$EXE_PATH\" $AMAZON_ARGS ${GAME_ARGS[*]}"
        else
            CMD_STR="$PYTHON_BIN $UMU_WRAPPER \"$EXE_PATH\" ${GAME_ARGS[*]}"
        fi
        log "Executing: $CMD_STR"

        # Notify user that game is launching
        notify_stage "toasts.launcher.launchingGame" "toasts.launcher.startingAmazonGame" "low"

        # DO NOT restore Steam's LD_PRELOAD here.
        # All umu-run launches go through pressure-vessel (a container) which has
        # its own Steam overlay mechanism.  Re-exporting the host's
        # gameoverlayrenderer.so via LD_PRELOAD causes "cannot be preloaded"
        # errors and can crash/early-exit the game process (WARNING: Keyboard
        # Interrupt).  Matches the Epic path (lines 1365-1371).

        # Execute umu-run for Amazon game (with retry for network failures)
        # WRAPPERS prepend the command, GAME_ARGS passed as game arguments.
        if [ -n "$AMAZON_ARGS" ]; then
            eval "${WRAPPERS[@]}" run_umu_with_retry "$PYTHON_BIN" "$UMU_WRAPPER" "\"$EXE_PATH\"" $AMAZON_ARGS "${GAME_ARGS[@]}" \
                && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?
        else
            "${WRAPPERS[@]}" run_umu_with_retry "$PYTHON_BIN" "$UMU_WRAPPER" "$EXE_PATH" "${GAME_ARGS[@]}" \
                && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?
        fi

        wait_for_game_exit

        log "Amazon game exited with code: $GAME_EXIT_CODE"
        exit $GAME_EXIT_CODE
    else
        # GOG games: use direct umu-run (no legendary needed)
        log "Launching GOG game via umu-run..."

        # Change to work directory (CRITICAL: game needs to find its resources)
        if [ -d "$WORK_DIR" ]; then
            cd "$WORK_DIR"
            log "Changed to: $WORK_DIR"
        fi
        PYTHON_BIN=""
        for py in /usr/bin/python3.13 /usr/bin/python3.12 /usr/bin/python3.11 /usr/bin/python3.10 /usr/bin/python3; do
            if [ -x "$py" ]; then
                PYTHON_BIN="$py"
                break
            fi
        done
        if [ -z "$PYTHON_BIN" ]; then
            PYTHON_BIN="python3"
        fi
        log "Using Python: $PYTHON_BIN"

        # Get the umu-run path
        if [ -f "$UMU_RUN" ]; then
            UMU_WRAPPER="$UMU_RUN"
            log "Using bundled umu-run: $UMU_WRAPPER"
        elif command -v umu-run &>/dev/null; then
            UMU_WRAPPER="umu-run"
            log "Using system umu-run"
        else
            log "ERROR: umu-run not found"
            exit 1
        fi

        # === GOG GALAXY STUB: Install GalaxyCommunication.exe dummy ===
        # Some GOG games expect Galaxy services - this stub prevents failures
        GALAXY_STUB_SCRIPT="$PLUGIN_DIR/bin/galaxy_stub.py"
        if [ -f "$GALAXY_STUB_SCRIPT" ]; then
            log "[Galaxy] Installing GalaxyCommunication.exe stub..."
            python3 "$GALAXY_STUB_SCRIPT" "$PREFIX_PATH" >> "$HOME/.local/share/unifideck/winetricks.log" 2>&1
        fi

        # === GOG SETUP: Install redistributables on first launch ===
        # Port of Heroic's setup.ts - installs DirectX, vcrun, etc. from GOG manifests
        # Uses marker file to run only once per game prefix
        SETUP_MARKER="$PREFIX_PATH/.unifideck-gog-setup-done"
        GOG_SETUP_SCRIPT="$PLUGIN_DIR/bin/gog_setup.py"
        
        # Verify if goggame-*.info exists, if not, force setup
        # This handles cases where the marker exists but setup failed to generate the info file
        GOG_INFO_FILE=$(find "$WORK_DIR" -maxdepth 2 -iname "goggame-*.info" | head -n 1)
        if [ -z "$GOG_INFO_FILE" ]; then
            log "[Setup] goggame-*.info file is missing. Forcing setup to generate it."
            rm -f "$SETUP_MARKER"
        fi

        if [ ! -f "$SETUP_MARKER" ] && [ -f "$GOG_SETUP_SCRIPT" ]; then
            log "[Setup] Running first-time GOG redistributable installation..."
            notify_stage "toasts.launcher.installingRedist" "toasts.launcher.installingRedistMessage" "normal"

            # Read language from .unifideck-id marker (written during installation)
            # This ensures the game setup uses the same language as the installation
            INSTALL_LANG="en-US"
            UNIFIDECK_ID_FILE="$WORK_DIR/.unifideck-id"
            if [ -f "$UNIFIDECK_ID_FILE" ]; then
                INSTALL_LANG=$(python3 -c "import json; print(json.load(open('$UNIFIDECK_ID_FILE')).get('language', 'en-US'))" 2>/dev/null || echo "en-US")
                log "[Setup] Using language from marker: $INSTALL_LANG"
            else
                log "[Setup] No .unifideck-id marker found, using default language: $INSTALL_LANG"
            fi

            # Create marker FIRST to prevent double-launch
            touch "$SETUP_MARKER"

            if python3 "$GOG_SETUP_SCRIPT" "$GAME_ID" "$PREFIX_PATH" "$WORK_DIR" "$INSTALL_LANG" >> "$HOME/.local/share/unifideck/gog_setup.log" 2>&1; then
                log "[Setup] Redistributable installation completed successfully"
            else
                # Setup failed - remove marker and abort launch
                log "[Setup] ERROR: Installation failed, see gog_setup.log for details"
                rm -f "$SETUP_MARKER"
                notify_stage "toasts.launcher.setupFailed" "toasts.launcher.setupFailedMessage" "critical"
                exit 1
            fi
        elif [ -f "$SETUP_MARKER" ]; then
            log "[Setup] Redistributables already installed, skipping"
        fi

        # === WINETRICKS: Install common redistributables ===
        # Supplements gog_setup.py (which only installs GOG-declared deps)
        # with broader coverage (VC++ runtimes, .NET, DirectX, fonts, etc.)
        WINETRICKS_MARKER="$PREFIX_PATH/unifideck_winetricks_complete.marker"
        WINETRICKS_GOG_SCRIPT="$PLUGIN_DIR/bin/winetricks_gog.py"

        if [ ! -f "$WINETRICKS_MARKER" ] || ! grep -qi "complete\|no redistributables\|failed" "$WINETRICKS_MARKER" 2>/dev/null; then
            if [ -f "$WINETRICKS_GOG_SCRIPT" ]; then
                log "[Winetricks] Running GOG redistributables installation..."
                notify_stage "toasts.launcher.dependenciesTitle" "toasts.launcher.installingRedistributables" "normal"

                if python3 "$WINETRICKS_GOG_SCRIPT" "$GAME_ID" "$PREFIX_PATH" >> "$HOME/.local/share/unifideck/winetricks.log" 2>&1; then
                    log "[Winetricks] Installation completed successfully"
                    notify_stage "toasts.launcher.dependenciesReady" "toasts.launcher.redistributablesInstalled" "low"
                else
                    log "[Winetricks] Installation completed (may have warnings)"
                    notify_stage "toasts.launcher.dependenciesStatus" "toasts.launcher.checkLogs" "low"
                fi
            fi
        else
            log "[Winetricks] Redistributables already installed, skipping"
        fi

        # Enable NVAPI for modern Proton (matches Epic path)
        export PROTON_ENABLE_NVAPI="1"
        export DXVK_NVAPI_ALLOW_OTHER_DRIVERS="1"

        # Explicitly set STEAM_COMPAT_INSTALL_PATH so umu-run uses the actual work dir
        # (Needed for games where the executable is in a subdirectory like Launcher/)
        export STEAM_COMPAT_INSTALL_PATH="$WORK_DIR"

        # === LANGUAGE FIX: Set game language based on Unifideck preference ===
        # GOG games read language from goggame-*.info in the install directory.
        # This modifies that file to use the user's preferred language.
        GOG_LANG_SCRIPT="$PLUGIN_DIR/bin/gog_set_language.py"
        if [ -f "$GOG_LANG_SCRIPT" ]; then
            log "[Language] Setting game language based on Unifideck preference..."
            python3 "$GOG_LANG_SCRIPT" "$GAME_ID" "$WORK_DIR" >> "$HOME/.local/share/unifideck/gog_language.log" 2>&1 || true
        fi

        CMD_STR="$PYTHON_BIN $UMU_WRAPPER \"$EXE_PATH\""
        log "Executing: $CMD_STR"

        # === CLOUD SAVE: Download before launch ===
        sync_cloud_saves "gog" "$GAME_ID" "download" "$PREFIX_PATH" ""

        # === COMET: Launch GOG Galaxy SDK replacement ===
        # Comet provides GOG Galaxy online features (achievements, multiplayer, etc.)
        COMET_BIN="$PLUGIN_DIR/bin/comet"
        COMET_PID=""
        if [ -f "$COMET_BIN" ]; then
            # Get GOG tokens from Unifideck config
            GOG_TOKEN_FILE="$HOME/.config/unifideck/gog_token.json"
            if [ -f "$GOG_TOKEN_FILE" ]; then
                GOG_ACCESS_TOKEN=$(python3 -c "import json; print(json.load(open('$GOG_TOKEN_FILE')).get('access_token',''))" 2>/dev/null)
                GOG_REFRESH_TOKEN=$(python3 -c "import json; print(json.load(open('$GOG_TOKEN_FILE')).get('refresh_token',''))" 2>/dev/null)
                GOG_USER_ID=$(python3 -c "import json; print(json.load(open('$GOG_TOKEN_FILE')).get('user_id',''))" 2>/dev/null)
                GOG_USERNAME=$(python3 -c "import json; print(json.load(open('$GOG_TOKEN_FILE')).get('username','GOGUser'))" 2>/dev/null)
                
                # If no username stored, use a default
                [ -z "$GOG_USERNAME" ] && GOG_USERNAME="GOGUser"
                
                if [ -n "$GOG_ACCESS_TOKEN" ] && [ -n "$GOG_REFRESH_TOKEN" ]; then
                    log "[Comet] Starting GOG Galaxy SDK replacement..."
                    # Launch Comet in background with tokens
                    COMET_ARGS="--username $GOG_USERNAME --access-token $GOG_ACCESS_TOKEN --refresh-token $GOG_REFRESH_TOKEN --quit"
                    [ -n "$GOG_USER_ID" ] && COMET_ARGS="$COMET_ARGS --user-id $GOG_USER_ID"
                    
                    "$COMET_BIN" $COMET_ARGS >> "$HOME/.local/share/unifideck/comet.log" 2>&1 &
                    COMET_PID=$!
                    log "[Comet] Started with PID $COMET_PID"
                else
                    log "[Comet] WARNING: No GOG tokens available, Galaxy online features disabled"
                fi
            else
                log "[Comet] No GOG token file found, Galaxy online features disabled"
            fi
        else
            log "[Comet] Binary not found at $COMET_BIN"
        fi

        # Notify user that game is launching
        notify_stage "toasts.launcher.launchingGame" "toasts.launcher.startingGogGame" "low"

        # DO NOT restore Steam's LD_PRELOAD here.
        # All umu-run launches go through pressure-vessel (a container) which has
        # its own Steam overlay mechanism.  Re-exporting the host's
        # gameoverlayrenderer.so via LD_PRELOAD causes "cannot be preloaded"
        # errors and can crash/early-exit the game process (WARNING: Keyboard
        # Interrupt).  Matches the Epic path (lines 1365-1371).

        # Execute umu-run with retry for network failures
        # WRAPPERS (from %command% split) prepend the game command.
        # GAME_ARGS (post-%command% tokens) are passed as game arguments.
        LAUNCH_START=$(date +%s)
        "${WRAPPERS[@]}" run_umu_with_retry "$PYTHON_BIN" "$UMU_WRAPPER" "$EXE_PATH" "${GAME_ARGS[@]}" \
            && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?

        # === GOG LAUNCHER FALLBACK ===
        # If the primary executable exited quickly (< 15s), it may be a broken
        # launcher stub (e.g., Uplay's Launcher.exe for Prince of Persia).
        # These stubs exit fast — sometimes with code 0, sometimes non-zero —
        # because the backing service (Uplay/UConnect) isn't installed.
        # We don't check the exit code: a real game session lasts minutes/hours,
        # so any exit under 15s from a 'launcher'-category task is suspicious.
        # 15s is tight enough to avoid false positives from a user manually
        # closing a working launcher (Wine startup + window render + user
        # interaction takes at least 15s). Only 'launcher'/'tool' category
        # primary tasks can trigger this — game-category tasks are never bypassed.
        LAUNCH_ELAPSED=$(( $(date +%s) - LAUNCH_START ))
        if [ "$LAUNCH_ELAPSED" -lt 15 ]; then
            FALLBACK_EXE=$("$PYTHON_BIN" -c "
import json, glob, os, sys
for f in glob.glob(os.path.join(sys.argv[1], 'goggame-*.info')):
    try:
        data = json.load(open(f))
    except Exception:
        continue
    tasks = data.get('playTasks', [])
    # Only fall back if the primary task is a launcher stub, not a real game exe.
    # Real launchers (e.g. The Witcher's launcher) run for the full session so
    # LAUNCH_ELAPSED will be >> 15s. If they DO crash fast, we still want to
    # avoid silently bypassing them unless the task is explicitly a launcher type.
    primary = next((t for t in tasks if t.get('isPrimary')), None)
    if not primary or primary.get('category', '').lower() not in ('launcher', 'tool'):
        break
    for t in tasks:
        if t.get('category') == 'game' and t.get('type') == 'FileTask' and t.get('path'):
            p = os.path.join(sys.argv[1], t['path'].replace(chr(92), '/'))
            if os.path.isfile(p):
                print(p)
                sys.exit(0)
    break
" "$WORK_DIR" 2>/dev/null)

            if [ -n "$FALLBACK_EXE" ] && [ "$FALLBACK_EXE" != "$EXE_PATH" ]; then
                log "[GOG] Launcher stub exited early (code $GAME_EXIT_CODE in ${LAUNCH_ELAPSED}s), falling back to game exe: $FALLBACK_EXE"
                notify_stage "toasts.launcher.launcherFallback" "toasts.launcher.retryingWithGameExe" "normal"
                "${WRAPPERS[@]}" run_umu_with_retry "$PYTHON_BIN" "$UMU_WRAPPER" "$FALLBACK_EXE" "${GAME_ARGS[@]}" \
                    && GAME_EXIT_CODE=$? || GAME_EXIT_CODE=$?
            fi
        fi

        wait_for_game_exit

        # === COMET: Stop after game exits ===
        if [ -n "$COMET_PID" ]; then
            log "[Comet] Stopping (PID $COMET_PID)..."
            kill "$COMET_PID" 2>/dev/null || true
            wait "$COMET_PID" 2>/dev/null || true
            log "[Comet] Stopped"
        fi

        # === CLOUD SAVE: Upload after exit ===
        log "GOG game exited with code: $GAME_EXIT_CODE"
        sync_cloud_saves "gog" "$GAME_ID" "upload" "$PREFIX_PATH" ""

        exit $GAME_EXIT_CODE
    fi
    
else
    # Native Linux game
    log "Native Linux game detected"
    
    # Change to work directory
    if [ -d "$WORK_DIR" ]; then
        cd "$WORK_DIR"
        log "Changed to: $WORK_DIR"
    fi
    
    # Ensure executable permissions
    chmod +x "$EXE_PATH" 2>/dev/null || true
    
    # Try Steam Runtime for legacy library support (libssl.so.1.0.0, etc)
    STEAM_RUNTIME_RUN="$HOME/.steam/steam/ubuntu12_32/steam-runtime/run.sh"
    STEAM_RUNTIME_ALT="$HOME/.local/share/Steam/ubuntu12_32/steam-runtime/run.sh"

    # Restore Steam Overlay/Input for native Linux games (critical for controller support)
    restore_steam_env

    if [ -f "$STEAM_RUNTIME_RUN" ]; then
        log "Using Steam Runtime: $STEAM_RUNTIME_RUN"
        log "Executing: $STEAM_RUNTIME_RUN $EXE_PATH $*"
        exec "$STEAM_RUNTIME_RUN" "$EXE_PATH" "$@" 2>>"$LOG_FILE"
    elif [ -f "$STEAM_RUNTIME_ALT" ]; then
        log "Using Steam Runtime (alt): $STEAM_RUNTIME_ALT"
        log "Executing: $STEAM_RUNTIME_ALT $EXE_PATH $*"
        exec "$STEAM_RUNTIME_ALT" "$EXE_PATH" "$@" 2>>"$LOG_FILE"
    else
        # Fallback: direct execution (may fail for old games needing legacy libs)
        log "No Steam Runtime found, executing directly"
        log "Executing: $EXE_PATH $*"
        exec "$EXE_PATH" "$@" 2>>"$LOG_FILE"
    fi
fi

# If exec fails, log it
log "ERROR: exec failed for $EXE_PATH (exit code: $?)"
exit 1
